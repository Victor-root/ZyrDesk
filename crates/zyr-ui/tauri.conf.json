{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZyrDesk",
  "version": "0.1.0",
  "identifier": "app.zyrdesk",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZyrDesk",
        "width": 1060,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../packaging/brand/zyrdesk-256.png",
      "../../packaging/brand/zyrdesk.ico"
    ]
  }
}
